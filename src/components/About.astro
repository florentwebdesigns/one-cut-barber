---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { business } from '../data/business';
import { shopImages } from '../data/gallery';
import { directionsLink, bookingLink } from '../lib/links';

const facts = [
  { k: 'Location', v: `${business.address.street}, ${business.address.city}, ${business.address.region}` },
  { k: 'Walk-ins', v: 'Welcome, or book ahead by text' },
  { k: 'Family', v: 'Kid-friendly' },
  { k: 'Parking', v: 'Free parking' },
];
---

<section class="about section" id="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <figure class="about__main" data-reveal="clip">
      <div class="about__main-img">
        <div class="about__par" data-parallax="0.05">
          <Image
            src={shopImages.shopFloor}
            alt="Inside One Cut: a barber working on a client in a camo cape while the team looks on, with black leather barber chairs, lit mirrors, a ring light and oak floors"
            widths={[640, 1000, 1368]}
            sizes="(max-width: 760px) 100vw, 58vw"
            format="webp"
            quality={84}
            loading="lazy"
          />
        </div>
      </div>
      <figcaption>On the floor at One Cut, Mountain Avenue</figcaption>
    </figure>

    <figure class="about__inset" data-reveal="clip" style="--d:250">
      <div class="about__inset-img">
        <div class="about__par" data-parallax="-0.05">
          <Image
            src={shopImages.windowLowFade}
            alt="A finished low fade and beard in front of the One Cut Barber Shop window lettering"
            widths={[360, 744]}
            sizes="(max-width: 760px) 44vw, 20vw"
            format="webp"
            quality={82}
            loading="lazy"
          />
        </div>
      </div>
    </figure>

    <div class="about__copy">
      <p class="eyebrow" data-reveal>The Shop</p>
      <h2 id="about-title" class="about__title display" data-split>
        <span class="split-line"><span>A calm room</span></span>
        <span class="split-line" style="--i:1"><span>for a <em class="gold-text">sharp</em> cut.</span></span>
      </h2>
      <p class="about__body" data-reveal style="--d:200">
        Established in {business.established} on Mountain Avenue in Springfield. Black leather chairs, lit mirrors,
        warm light and a fireplace in the lounge set the tone. In the chair, it’s fades, tapers, freehand designs and
        beard work, finished properly.
      </p>
      <div class="about__ctas" data-reveal style="--d:280">
        <a class="btn btn--gold" href={bookingLink()}>
          <Icon name="message" />
          Book by Text
        </a>
        <a class="link-line" href={directionsLink()} target="_blank" rel="noopener">
          Get directions <Icon name="arrow" />
        </a>
      </div>
    </div>

    <dl class="about__facts" data-reveal style="--d:320">
      {
        facts.map((f) => (
          <div>
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(64px, 8vw, 128px);
  }
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: clamp(24px, 3vw, 40px);
    align-items: start;
  }
  .about__main {
    grid-column: 1 / span 7;
    grid-row: 1 / span 2;
    position: relative;
  }
  .about__main-img {
    aspect-ratio: 1368 / 936;
    overflow: hidden;
    background: var(--char);
  }
  .about__par {
    width: 100%;
    height: 100%;
  }
  .about__main :global(img),
  .about__inset :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about__main figcaption {
    margin-top: 14px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .about__inset {
    grid-column: 6 / span 3;
    grid-row: 3;
    margin-top: -42%;
    position: relative;
    z-index: 2;
    border: 1px solid rgba(198, 161, 91, 0.35);
    padding: 8px;
    background: rgba(10, 10, 10, 0.85);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.8);
  }
  .about__inset-img {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }
  .about__copy {
    grid-column: 9 / span 4;
    grid-row: 1;
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .about__title {
    font-size: var(--step-4);
    line-height: 0.98;
  }
  .about__body {
    color: var(--bone-2);
    max-width: 30em;
  }
  .about__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
  .about__facts {
    grid-column: 9 / span 4;
    grid-row: 2 / span 2;
    align-self: start;
    width: 100%;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .about__facts > div {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .about__facts dt {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    padding-top: 0.3em;
  }
  .about__facts dd {
    color: var(--bone);
  }

  @media (max-width: 1080px) {
    .about__main {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .about__copy {
      grid-column: 1 / span 7;
      grid-row: 1;
    }
    .about__facts {
      grid-column: 1 / span 7;
      grid-row: 3;
    }
    .about__inset {
      grid-column: 9 / span 4;
      grid-row: 3;
      margin-top: -30%;
    }
  }

  @media (max-width: 760px) {
    .about__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .about__copy {
      grid-column: 1 / -1;
    }
    .about__main {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .about__main figcaption {
      max-width: 48%;
      line-height: 1.6;
    }
    .about__inset {
      grid-column: 4 / span 3;
      grid-row: 2;
      align-self: end;
      margin-top: 0;
      margin-bottom: -26%;
    }
    .about__facts {
      grid-column: 1 / -1;
      grid-row: 3;
      margin-top: 84px;
    }
  }
</style>
