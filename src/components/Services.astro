---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { services, serviceNotes, formatPrice } from '../data/services';
import { shopImages } from '../data/gallery';
import { business } from '../data/business';
import { bookingLink, telLink } from '../lib/links';
---

<section class="services section blend" id="services" aria-labelledby="services-title">
  <div class="wrap services__grid">
    <header class="services__head">
      <p class="eyebrow" data-reveal>Services & Pricing</p>
      <h2 id="services-title" class="services__title display" data-split>
        <span class="split-line"><span>The</span></span>
        <span class="split-line" style="--i:1"><span><em class="gold-text">menu.</em></span></span>
      </h2>
      <figure class="services__img" data-reveal="clip" style="--d:200">
        <Image
          src={shopImages.beardLineup}
          alt="A barber in black gloves lining up a client’s beard with a trimmer"
          widths={[400, 538]}
          sizes="(max-width: 900px) 60vw, 26vw"
          format="webp"
          quality={82}
          loading="lazy"
        />
      </figure>
    </header>

    <div class="services__list-wrap">
      <ul class="menu-list" role="list">
        {
          services.map((s, i) => (
            <li class:list={['menu-item', { 'menu-item--sig': s.signature }]} data-reveal style={`--d:${i * 90}`}>
              <div class="menu-item__row">
                <h3 class="menu-item__name">{s.name}</h3>
                <span class="menu-item__leader" aria-hidden="true" />
                <p class="menu-item__price tnum">
                  <span class="sr-only">Price: </span>
                  {formatPrice(s.price)}
                </p>
                <a class="menu-item__book" href={bookingLink()} data-book-service={s.name} aria-label={`Book ${s.name}`}>
                  Book <Icon name="arrow" />
                </a>
              </div>
              {(s.note || s.signature) && (
                <p class="menu-item__note">{s.signature ? 'The signature service' : s.note}</p>
              )}
            </li>
          ))
        }
      </ul>

      <ul class="services__notes" data-reveal>
        {serviceNotes.map((n) => <li>{n}</li>)}
      </ul>

      <div class="services__cta" data-reveal>
        <div>
          <p class="services__cta-title display">Looking for a specific service?</p>
          <p class="muted">Contact us for current availability and pricing.</p>
        </div>
        <div class="services__cta-btns">
          <a class="btn btn--gold" href={bookingLink()} data-book-service="Something else">
            <Icon name="message" />
            Text Us
          </a>
          <a class="btn btn--ghost" href={telLink()}>
            <Icon name="phone" />
            Call
          </a>
        </div>
        <p class="services__phone tnum">
          {business.phone.display} · calls and texts
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    overflow: hidden;
    --blend-bg:
      radial-gradient(45% 40% at 12% 30%, rgba(207, 198, 184, 0.06), transparent 70%),
      radial-gradient(40% 50% at 100% 100%, rgba(198, 161, 91, 0.07), transparent 70%),
      linear-gradient(180deg, rgba(9, 9, 9, 0.55), rgba(9, 9, 9, 0.2));
  }
  .services__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
  }
  .services__head {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
    display: grid;
    gap: 26px;
    justify-items: start;
  }
  .services__title {
    font-size: var(--step-5);
    line-height: 0.9;
  }
  .services__img {
    width: min(78%, 360px);
    aspect-ratio: 7 / 8;
    overflow: hidden;
    margin-top: 12px;
    background: var(--char);
  }
  .services__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu-list {
    border-top: 1px solid var(--line-strong);
  }
  .menu-item {
    padding: clamp(18px, 2.2vw, 28px) 0;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--t-sm) var(--ease);
  }
  .menu-item__row {
    display: flex;
    align-items: baseline;
    gap: 18px;
  }
  .menu-item__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-3);
    line-height: 1.05;
    letter-spacing: -0.01em;
    min-width: 0;
    transition:
      transform 600ms var(--ease),
      color var(--t-sm) var(--ease);
  }
  .menu-item__leader {
    flex: 1;
    min-width: 24px;
    height: 1px;
    transform: translateY(-0.3em);
    background-image: radial-gradient(circle, rgba(198, 161, 91, 0.55) 1px, transparent 1.3px);
    background-size: 9px 3px;
    background-repeat: repeat-x;
    background-position: 0 50%;
    height: 3px;
  }
  .menu-item__price {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--champagne);
  }
  .menu-item__book {
    flex: none;
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: 6px;
    padding: 10px 14px;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--champagne);
    border: 1px solid rgba(198, 161, 91, 0.35);
    border-radius: 100px;
    transition:
      background-color var(--t-sm) var(--ease),
      color var(--t-sm) var(--ease),
      border-color var(--t-sm) var(--ease);
  }
  .menu-item__book :global(svg) {
    width: 14px;
    height: 14px;
    transition: transform var(--t-sm) var(--ease);
  }
  .menu-item__book:hover,
  .menu-item:hover .menu-item__book {
    color: #17130b;
    background: var(--gold-metal);
    border-color: transparent;
  }
  .menu-item__book:hover :global(svg) {
    transform: translateX(3px);
  }
  .menu-item__note {
    margin-top: 8px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .menu-item:hover .menu-item__name {
    transform: translateX(8px);
    font-style: italic;
  }
  .menu-item--sig .menu-item__name {
    font-style: italic;
  }
  .menu-item--sig .menu-item__note {
    color: var(--gold);
  }
  .menu-item--sig .menu-item__price {
    background: var(--gold-metal);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .services__notes {
    margin-top: 26px;
    display: grid;
    gap: 6px;
    font-size: 0.86rem;
    color: var(--mist);
  }
  .services__notes li::before {
    content: '*';
    color: var(--gold);
    margin-right: 8px;
  }

  .services__cta {
    margin-top: clamp(48px, 6vw, 80px);
    padding: clamp(28px, 3.5vw, 44px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px 32px;
    align-items: center;
    border: 1px solid rgba(198, 161, 91, 0.28);
    background:
      linear-gradient(135deg, rgba(198, 161, 91, 0.08), rgba(198, 161, 91, 0) 60%),
      rgba(255, 255, 255, 0.012);
  }
  .services__cta-title {
    font-size: var(--step-2);
    line-height: 1.1;
    margin-bottom: 6px;
  }
  .services__cta-btns {
    display: flex;
    gap: 10px;
  }
  .services__phone {
    grid-column: 2;
    justify-self: center;
    font-size: 0.82rem;
    color: var(--mist);
  }
  .services__phone a {
    color: var(--bone);
    border-bottom: 1px solid rgba(198, 161, 91, 0.5);
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
    .services__head {
      position: static;
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .services__head .eyebrow {
      grid-column: 1 / -1;
    }
    .services__img {
      width: clamp(120px, 34vw, 220px);
      margin-top: 0;
    }
  }
  @media (max-width: 560px) {
    .menu-item__row {
      gap: 12px;
    }
    .menu-item__name,
    .menu-item__price {
      font-size: 1.85rem;
    }
    .services__cta {
      grid-template-columns: 1fr;
    }
    .services__cta-btns {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .menu-item__book {
      padding: 9px 11px;
      margin-left: 2px;
    }
    .menu-item__book :global(svg) {
      display: none;
    }
    .services__phone {
      grid-column: 1;
    }
  }
</style>
