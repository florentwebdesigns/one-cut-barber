---
import Logo from './Logo.astro';
import Hours from './Hours.astro';
import { business } from '../data/business';
import { telLink, directionsLink } from '../lib/links';

const links = [
  { href: '#top', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#services', label: 'Services' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#visit', label: 'Contact' },
];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__brand">
      <Logo class="footer__logo" gold />
      <p class="footer__sub">Barber Shop <span aria-hidden="true">—</span> Est. {business.established}</p>
    </div>

    <div class="footer__grid">
      <nav aria-label="Footer">
        <p class="footer__k">Explore</p>
        <ul>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <p class="footer__k">Visit</p>
        <address>
          <a href={directionsLink()} target="_blank" rel="noopener">
            {business.address.street}<br />
            {business.address.city}, {business.address.region} {business.address.postalCode}
          </a>
        </address>
      </div>
      <div>
        <p class="footer__k">Call</p>
        <a class="tnum" href={telLink()}>{business.phone.display}</a>
      </div>
      <div class="footer__hours">
        <p class="footer__k">Hours</p>
        <Hours compact />
      </div>
    </div>

    <div class="footer__base">
      <p>© {year} {business.name}. All rights reserved.</p>
      <p>Website by <span class="footer__credit">FD Web Designs</span></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: clamp(80px, 10vw, 140px) calc(32px + env(safe-area-inset-bottom, 0px));
    background: rgba(6, 6, 6, 0.82);
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    color: var(--bone-2);
  }
  .footer__brand {
    display: grid;
    gap: 16px;
    padding-bottom: clamp(48px, 6vw, 80px);
    border-bottom: 1px solid var(--line);
  }
  .footer__brand :global(.footer__logo) {
    justify-self: start;
    height: clamp(64px, 11vw, 160px);
    width: auto;
    max-width: 100%;
  }
  .footer__sub {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr 1.4fr;
    gap: 40px;
    padding-block: clamp(40px, 5vw, 64px);
  }
  .footer__k {
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
  }
  .footer ul {
    display: grid;
    gap: 6px;
  }
  .footer a {
    transition: color var(--t-sm) var(--ease);
  }
  .footer a:hover {
    color: var(--champagne);
  }
  .footer address {
    font-style: normal;
    line-height: 1.6;
  }
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    font-size: 0.78rem;
    color: var(--mist-2);
  }
  .footer__credit {
    color: var(--bone-2);
  }
  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 760px) {
    .footer {
      padding-bottom: calc(100px + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
